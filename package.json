{
  "name": "tts-ds-r14",
  "version": "14.3.1",
  "private": true,
  "type": "module",
  "description": "TTS (Ticket to Show) Design System R14 — tokens.json как единый источник истины: сайт (dark/light) + SMM-слой.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitch-npc/tts-design-system.git"
  },
  "scripts": {
    "build": "node tooling/build-tokens.mjs && node tooling/build-smm.mjs",
    "build:check": "node tooling/build-tokens.mjs --check",
